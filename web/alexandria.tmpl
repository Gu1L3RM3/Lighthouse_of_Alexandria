    PYBUILD : "{{cookiecutter.PYBUILD}}",
    fb_ar   :  1.77,
    fb_width : "{{cookiecutter.width}}",
    fb_height : "{{cookiecutter.height}}"
}

const BOOT_TEXT = {
    title: "Lighthouse of Alexandria",
    tagline: "Story, puzzles and electricity",
    download: "Downloading the game",
    unpack: "Preparing the lighthouse",
    ready: "Click or tap to light the lighthouse",
    installing: "Installing ",
}

// lamp_level: 0 = dark lamp, 1 = fully lit; the download fills it, later states keep it lit
const BOOT_LAMP_LEVEL = { unpack: 0.85, ready: 1, installing: 1 }

const LAMP_TOP = 26
const LAMP_HEIGHT = 12

function set_lamp_level(level) {
    level = Math.max(0, Math.min(1, level))
    // whole pixels only, so the lamp fills like pixel art instead of a smooth bar
    const lit = Math.round(LAMP_HEIGHT * level)
    const lamp = document.getElementById("lamp-lit")
    lamp.setAttribute("y", LAMP_TOP + LAMP_HEIGHT - lit)
    lamp.setAttribute("height", lit)
    document.getElementById("lamp-glow").style.opacity = (level * 0.55).toFixed(2)
}

function boot_state(state, detail) {
    document.body.dataset.boot = state
    if (state === "done") {
        infobox.style.display = "none"
        boot.hidden = true
        return
    }
    if (state in BOOT_LAMP_LEVEL) set_lamp_level(BOOT_LAMP_LEVEL[state])
    infobox.innerText = BOOT_TEXT[state] + (detail ? detail : "")
}

// pygbag updates #progress during the wasm download; mirror it into the lamp and the label
function boot_track_download() {
    if (document.body.dataset.boot !== "download") return
    const ratio = progress.max ? progress.value / progress.max : 0
    set_lamp_level(ratio)
    infobox.innerText = BOOT_TEXT.download + (ratio > 0 ? " " + Math.round(ratio * 100) + "%" : "")
    requestAnimationFrame(boot_track_download)
}

// pythons.js may call this; the layout is pure CSS now, so it only has to make the box visible
function show_infobox() {
    infobox.style.display = "block"
}

</script>

