    <style>
        /* palette taken from main_menu_scene.py so the boot screen hands off to the menu seamlessly */
        :root {
            --sky-1: #0f142a;
            --sky-2: #171f3a;
            --sky-3: #212b4a;
            --sky-4: #2a385a;
            --sea: #183151;
            --stone: #b0a688;
            --stone-dark: #918568;
            --stone-light: #cdc29c;
            --flame: #ebb45c;
            --glow: #ffe08a;
            --cream: #f5e6aa;
            --muted: #a7916a;
            --pixel-font: "Press Start 2P", ui-monospace, monospace;
        }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: var(--sky-1);
            font-family: var(--pixel-font);
            color: var(--cream);
        }

        /* pygbag still writes into these; the lamp shows the progress instead */
        #transfer {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        #boot {
            position: fixed;
            inset: 0;
            z-index: 20;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5vh;
            padding: 0 16px;
            /* hard stops = the menu's banded pixel sky; the sea starts at 62% like the menu */
            background: linear-gradient(
                var(--sky-1) 0 15.5%, var(--sky-2) 15.5% 31%,
                var(--sky-3) 31% 46.5%, var(--sky-4) 46.5% 62%,
                var(--sea) 62% 100%);
        }

        #boot[hidden] { display: none; }

        #boot svg {
            height: min(44vh, 360px);
            overflow: visible;
            shape-rendering: crispEdges;
        }

        .beam {
            fill: var(--glow);
            opacity: 0;
        }

        [data-boot="ready"] .beam { animation: beam-sweep 2.4s steps(6) infinite; }
        [data-boot="ready"] .beam-right { animation-delay: -1.2s; }

        @keyframes beam-sweep {
            0%, 100% { opacity: 0; }
            50% { opacity: 0.22; }
        }

        #boot h1 {
            margin: 0;
            font-size: clamp(14px, 3.4vw, 34px);
            font-weight: 400;
            line-height: 1.4;
            letter-spacing: 0.04em;
            color: #f0d084;
            text-align: center;
            text-shadow: 0.12em 0.12em 0 var(--sky-1);
        }

        #boot p {
            margin: 0;
            font-size: clamp(8px, 1.3vw, 14px);
            line-height: 1.6;
            color: #ccb47e;
            text-align: center;
        }

        #infobox {
            position: fixed;
            left: 50%;
            bottom: 12vh;
            transform: translateX(-50%);
            z-index: 999999;
            max-width: calc(100vw - 32px);
            box-sizing: border-box;
            padding: 12px 18px;
            font-family: var(--pixel-font);
            font-size: clamp(8px, 1.2vw, 12px);
            line-height: 1.6;
            text-align: center;
            color: var(--muted);
            background: transparent;
        }

        /* the one state that needs the player: make it read as a button on the sea */
        [data-boot="ready"] #infobox {
            color: var(--sky-1);
            background: var(--glow);
            box-shadow: 0 0 0 4px var(--flame), 6px 6px 0 4px var(--sky-1);
            cursor: pointer;
        }

        /* the game is a fixed 16:9 canvas: on a phone held upright it would be a thin strip */
        #rotate {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1000000;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 32px;
            padding: 0 16px;
            background: var(--sky-1);
            color: var(--cream);
            text-align: center;
        }

        @media (orientation: portrait) and (pointer: coarse) {
            #rotate { display: flex; }
        }

        #rotate svg {
            width: 96px;
            shape-rendering: crispEdges;
            animation: turn-phone 2.4s steps(1) infinite;
        }

        /* hold upright, then snap sideways: a stepped turn reads as pixel art, not a smooth spin */
        @keyframes turn-phone {
            0%, 45% { transform: rotate(0deg); }
            50%, 95% { transform: rotate(-90deg); }
        }

        #rotate p {
            margin: 0;
            max-width: 22ch;
            font-size: 14px;
            line-height: 1.8;
        }

        @media (prefers-reduced-motion: reduce) {
            #rotate svg { animation: none; transform: rotate(-90deg); }
            [data-boot="ready"] .beam { animation: none; opacity: 0.18; }
        }

        div.emscripten { text-align: center; }
        div.emscripten_border { border: 1px solid black; }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        canvas.emscripten {
            border: 0px none;
            background-color: transparent;
            width: 100%;
            height: 100%;
            z-index: 5;
            padding: 0;
            margin: 0 auto;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            image-rendering: pixelated;
        }

        .bottomright {
            position: absolute;
            top: 40%;
            right: 0px;
        }

        .trinfo {
           position: relative;
           right: 0px;
           border: 1px solid black;
        }

        .framed {
           position: relative;
           top: 150px;
           right: 10px;
           border: 1px solid black;
        }
    </style>

